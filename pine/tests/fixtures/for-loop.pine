//@version=6
indicator("Window Score", overlay = false, precision = 1)

lookback = input.int(10, "Lookback", minval = 2, maxval = 50)
smoothing = input.int(3, "Smoothing", minval = 1)

score = 0.0
for i = 1 to lookback
    if close > close[i]
        score += 1
    else if close < close[i]
        score -= 1
    else
        continue

pct = 100 * score / lookback
total = 0.0
count = 0
while count < 5
    total += count
    count += 1

smooth = ta.sma(pct, smoothing)
change = ta.change(close)
momentum = ta.mom(close, lookback)
plot(pct, "Score", color = pct > 0 ? color.green : color.red, style = plot.style_columns)
plot(smooth, "Smoothed", color = color.yellow)
plot(total, "Total", display = display.none)
plot(change + momentum, "Momentum")
hline(0, "Zero")
